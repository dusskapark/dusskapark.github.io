#!/usr/bin/env bash
# Verifies the dev server is up and serving on the expected port.
set -euo pipefail
cd "$(dirname "$0")/../.."

set -a
# shellcheck disable=SC1091
source "$(dirname "$0")/env"
set +a

for _ in $(seq 1 60); do
  if curl -fsS -o /dev/null "http://localhost:${PORT}"; then
    echo "verify: dev server is responding on port ${PORT}."
    exit 0
  fi
  sleep 1
done

echo "verify: dev server did not respond on port ${PORT} in time." >&2
exit 1
