{
  "name": "hey-joo-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "predev": "pnpm prepare:links && pnpm prepare:assets",
    "dev": "vite",
    "prebuild": "pnpm prepare:links && pnpm prepare:assets",
    "build": "vite build && node scripts/generate-static-pages.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check:content": "node scripts/validate-content.mjs",
    "test": "node --test tests/content-parity.test.mjs tests/content-source.test.mjs tests/image-variants.test.mjs tests/jsx-attributes.test.mjs tests/link-preview-metadata.test.mjs",
    "prepare:links": "node scripts/prepare-link-previews.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "fetch:thumbnails": "node scripts/fetch-video-thumbnails.mjs",
    "fetch:tweets": "node scripts/fetch-tweets.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.69.0",
    "motion": "^13.4.4",
    "radix-ui": "^1.6.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "^7.18.5",
    "react-tweet": "^3.3.1",
    "rough-notation": "^0.5.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.6.0",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.12.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "vite": "^6.3.5"
  }
}
